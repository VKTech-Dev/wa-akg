# Dados persistentes de containers Docker (Regra DOCKER.md)
dados/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media files (downloaded by app)
/data/media/*
!/data/media/.gitkeep
# avatars (profile pictures fetched by the app)
/data/avatars/*
/public/media/*
server.log
/logs/

# graphify (grafo local gerado)
graphify-out/

